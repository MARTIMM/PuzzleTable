use v6.d;
use Test;

use PuzzleTable::Types;
use PuzzleTable::Config::Totals;

#-------------------------------------------------------------------------------
# Setup in PuzzleTable::Config
my Supplier $supplier .= new;
my Supply $supply = $supplier.Supply;

my PuzzleTable::Config::Totals $t .= new(:$supply);

#-------------------------------------------------------------------------------
# Use in other classes to update totals with supplier from PuzzleTable::Config
my $v;

# send command to add a value to TOTAL_PUZZLES
do-totals( :add, :n(4), :type(TOTAL_PUZZLES));
$v = do-totals( :get, :type(TOTAL_PUZZLES), :receive),
is $v, 4, [~] 'totals of ', TOTAL_PUZZLES.Str, " $v";

do-totals( :substract, :n(2), :type(TOTAL_PUZZLES));
$v = do-totals( :get, :type(TOTAL_PUZZLES), :receive),
is $v, 2, [~] 'totals of ', TOTAL_PUZZLES.Str, " $v";

do-totals( :add, :n(4), :type(UNTOUCHED_PUZZLES));
$v = do-totals( :get, :type(UNTOUCHED_PUZZLES), :receive),
is $v, 4, [~] 'totals of ', UNTOUCHED_PUZZLES.Str, " $v";

$v = do-totals( :report, :receive);
like $v, /'[ 2, 4, 0, 0 ]' /, "report\n$v";

done-testing;
exit;

#-------------------------------------------------------------------------------
sub do-totals ( Bool :$receive = False, *%data --> Mu ) {
  my Channel $channel;
  my Mu $v;

  if $receive {
    $channel .= new;
    $supplier.emit( %( :code(PROCESS_TOTALS), |%data, :$channel));

    $v = $channel.receive;
    $channel.close;
  }

  else {
    $supplier.emit( %( :code(PROCESS_TOTALS), |%data));
  }

  $v
}
